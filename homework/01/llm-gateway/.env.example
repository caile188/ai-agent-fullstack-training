# ---- 上游供应商密钥（gateway.yaml 中 auth.env 引用，支持 ${ENV} / ${ENV:-default} 插值）----
# 同一 DeepSeek 密钥分别以 Bearer(Responses) 与 x-api-key(Anthropic) 两种头使用
DEEPSEEK_API_KEY=sk-replace-me

# ---- 网关自身接入鉴权（auth.enabled=true 时生效；逗号分隔多个 key）----
GATEWAY_KEYS=gw-local-key

# ---- 运行参数（可选）----
# 配置文件路径，默认 gateway.yaml
# GATEWAY_CONFIG=gateway.yaml
